{
  "info": {
    "name": "Smart Parking",
    "description": "All requests go through the gateway ({{baseUrl}}). One folder per service/feature; run top to bottom, IDs are chained through the environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Gateway",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A fresh driver per run, so earlier runs or the frontend demo never block a reservation.",
                  "pm.collectionVariables.set('driverId', 'postman-' + Date.now());",
                  "pm.collectionVariables.set('otherDriverId', 'postman-other-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Gateway is up', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/health"
          }
        }
      ]
    },
    {
      "name": "Parking locations",
      "item": [
        {
          "name": "Create location",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Starts with the default hourly rule', () => pm.expect(body.pricing.strategy).to.eql('HOURLY'));",
                  "pm.test('Has no spots yet', () => pm.expect(body.totalSpots).to.eql(0));",
                  "pm.environment.set('locationId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/parking-locations",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Garage\",\n  \"address\": \"Strada Memorandumului 21\",\n  \"latitude\": 46.7701,\n  \"longitude\": 23.5878\n}"
            }
          }
        },
        {
          "name": "List locations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Contains the new location', () => pm.expect(pm.response.json().map(l => l.id)).to.include(pm.environment.get('locationId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/parking-locations"
          }
        },
        {
          "name": "Get location",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Is the new location', () => pm.expect(pm.response.json().name).to.eql('Postman Garage'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/parking-locations/{{locationId}}"
          }
        },
        {
          "name": "Update location",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Name changed', () => pm.expect(pm.response.json().name).to.eql('Postman Garage North'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/parking-locations/{{locationId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Garage North\",\n  \"address\": \"Strada Memorandumului 21\",\n  \"latitude\": 46.7701,\n  \"longitude\": 23.5878\n}"
            }
          }
        },
        {
          "name": "Set pricing rule (Strategy + Decorator extras)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const pricing = pm.response.json().pricing;",
                  "pm.test('Uses the tiered strategy', () => pm.expect(pricing.strategy).to.eql('TIERED'));",
                  "pm.test('Keeps only the rates TIERED needs', () => pm.expect(pricing.hourlyRate).to.be.null);",
                  "pm.test('Three price bands, in order', () => pm.expect(pricing.bands.map(b => b.fromHour)).to.eql([0, 1, 4]));",
                  "// The extras become decorators around the strategy in reservation-service.",
                  "pm.test('Extras are stored with the rule', () => {",
                  "    pm.expect(pricing.billingIncrementMinutes).to.eql(60);",
                  "    pm.expect(pricing.dailyCap).to.eql(30);",
                  "    pm.expect(pricing.surcharges.large).to.eql(20);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/parking-locations/{{locationId}}/pricing-rule",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"strategy\": \"TIERED\",\n  \"bands\": [\n    {\n      \"fromHour\": 0,\n      \"hourlyRate\": 8.0\n    },\n    {\n      \"fromHour\": 1,\n      \"hourlyRate\": 4.0\n    },\n    {\n      \"fromHour\": 4,\n      \"hourlyRate\": 2.0\n    }\n  ],\n  \"billingIncrementMinutes\": 60,\n  \"gracePeriodMinutes\": 0,\n  \"dailyCap\": 30.0,\n  \"surcharges\": {\n    \"compact\": -10,\n    \"large\": 20,\n    \"motorcycle\": -50,\n    \"evCharging\": 15\n  }\n}"
            }
          }
        },
        {
          "name": "Pricing rule missing a rate is rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Body is a ProblemDetail', () => pm.expect(pm.response.json().detail).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/parking-locations/{{locationId}}/pricing-rule",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"strategy\": \"NIGHT_WEEKEND\",\n  \"dayRate\": 6.0\n}"
            }
          }
        },
        {
          "name": "Pricing bands out of order are rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Body is a ProblemDetail', () => pm.expect(pm.response.json().detail).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/parking-locations/{{locationId}}/pricing-rule",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"strategy\": \"TIERED\",\n  \"bands\": [\n    {\n      \"fromHour\": 0,\n      \"hourlyRate\": 8.0\n    },\n    {\n      \"fromHour\": 0,\n      \"hourlyRate\": 4.0\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Add spots",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const spots = pm.response.json();",
                  "pm.test('Three spots numbered A1-A3', () => pm.expect(spots.map(s => s.code)).to.eql(['A1', 'A2', 'A3']));",
                  "pm.test('All free', () => spots.forEach(s => pm.expect(s.status).to.eql('AVAILABLE')));",
                  "pm.environment.set('spotId', spots[0].id);",
                  "pm.environment.set('spot2Id', spots[1].id);",
                  "pm.environment.set('spot3Id', spots[2].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/parking-locations/{{locationId}}/spots",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"level\": 0,\n  \"zone\": \"A\",\n  \"count\": 3,\n  \"type\": \"STANDARD\",\n  \"evCharging\": false,\n  \"accessible\": false\n}"
            }
          }
        },
        {
          "name": "List spots",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Lists three spots', () => pm.expect(pm.response.json()).to.have.lengthOf(3));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/parking-locations/{{locationId}}/spots"
          }
        },
        {
          "name": "Close spot (State)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Spot is out of service', () => pm.expect(pm.response.json().status).to.eql('OUT_OF_SERVICE'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/parking-locations/{{locationId}}/spots/{{spot2Id}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"OUT_OF_SERVICE\"\n}"
            }
          }
        },
        {
          "name": "Availability",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const counts = pm.response.json();",
                  "pm.test('Two free, one closed', () => { pm.expect(counts.AVAILABLE).to.eql(2); pm.expect(counts.OUT_OF_SERVICE).to.eql(1); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/parking-locations/{{locationId}}/availability"
          }
        },
        {
          "name": "Reopen spot",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Spot is available again', () => pm.expect(pm.response.json().status).to.eql('AVAILABLE'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/parking-locations/{{locationId}}/spots/{{spot2Id}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"AVAILABLE\"\n}"
            }
          }
        },
        {
          "name": "Unknown location is 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Body is a ProblemDetail', () => pm.expect(pm.response.json().detail).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/parking-locations/00000000-0000-0000-0000-000000000000"
          }
        }
      ]
    },
    {
      "name": "Reservations",
      "item": [
        {
          "name": "Reserve spot",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Reservation is active', () => pm.expect(body.status).to.eql('ACTIVE'));",
                  "pm.test('Holds the spot for 15 minutes', () => pm.expect(new Date(body.expiresAt) - new Date(body.createdAt)).to.eql(15 * 60 * 1000));",
                  "pm.environment.set('reservationId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/reservations",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"spotId\": \"{{spotId}}\",\n  \"driverId\": \"{{driverId}}\"\n}"
            }
          }
        },
        {
          "name": "Another driver cannot reserve the same spot",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('Body is a ProblemDetail', () => pm.expect(pm.response.json().detail).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/reservations",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"spotId\": \"{{spotId}}\",\n  \"driverId\": \"{{otherDriverId}}\"\n}"
            }
          }
        },
        {
          "name": "Spot shows as reserved",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const spot = pm.response.json().find(s => s.id === pm.environment.get('spotId'));",
                  "pm.test('Reserved by this driver', () => { pm.expect(spot.status).to.eql('RESERVED'); pm.expect(spot.heldBy).to.eql(pm.collectionVariables.get('driverId')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/parking-locations/{{locationId}}/spots"
          }
        },
        {
          "name": "Get reservation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Shows spot and location names', () => { pm.expect(pm.response.json().spotCode).to.eql('A1'); pm.expect(pm.response.json().locationName).to.eql('Postman Garage North'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/reservations/{{reservationId}}"
          }
        },
        {
          "name": "Current parking shows the reservation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has the reservation', () => pm.expect(pm.response.json().reservation.id).to.eql(pm.environment.get('reservationId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/reservations/current?driverId={{driverId}}"
          }
        },
        {
          "name": "Cancel reservation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/reservations/{{reservationId}}"
          }
        },
        {
          "name": "Cancelling twice is a conflict",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('Body is a ProblemDetail', () => pm.expect(pm.response.json().detail).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/reservations/{{reservationId}}"
          }
        },
        {
          "name": "Spot freed by reservation.cancelled",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 300);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Eventually consistent: the change arrives through RabbitMQ, so retry for a few seconds.",
                  "let ok = false;",
                  "try { const body = pm.response.json(); ok = pm.response.code === 200 && (body.find(s => s.id === pm.environment.get('spotId')).status === 'AVAILABLE'); } catch (e) { ok = false; }",
                  "const tries = Number(pm.collectionVariables.get('tries') || 0);",
                  "if (!ok && tries < 20) {",
                  "    pm.collectionVariables.set('tries', tries + 1);",
                  "    pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "    pm.collectionVariables.set('tries', 0);",
                  "    pm.test('Arrived through RabbitMQ', () => pm.expect(ok).to.be.true);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/parking-locations/{{locationId}}/spots"
          }
        },
        {
          "name": "Reserve spot again",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.environment.set('reservationId', pm.response.json().id);",
                  "pm.environment.set('reservationExpiresAt', pm.response.json().expiresAt);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/reservations",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"spotId\": \"{{spotId}}\",\n  \"driverId\": \"{{driverId}}\"\n}"
            }
          }
        },
        {
          "name": "Move reservation to another spot",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Now holds A3', () => { pm.expect(body.spotId).to.eql(pm.environment.get('spot3Id')); pm.expect(body.spotCode).to.eql('A3'); });",
                  "pm.test('Hold time unchanged', () => pm.expect(new Date(body.expiresAt).getTime()).to.eql(new Date(pm.environment.get('reservationExpiresAt')).getTime()));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/reservations/{{reservationId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"spotId\": \"{{spot3Id}}\"\n}"
            }
          }
        },
        {
          "name": "Previous spot freed by reservation.changed",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 300);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Eventually consistent: the change arrives through RabbitMQ, so retry for a few seconds.",
                  "let ok = false;",
                  "try { const body = pm.response.json(); ok = pm.response.code === 200 && (body.find(s => s.id === pm.environment.get('spotId')).status === 'AVAILABLE' && body.find(s => s.id === pm.environment.get('spot3Id')).status === 'RESERVED'); } catch (e) { ok = false; }",
                  "const tries = Number(pm.collectionVariables.get('tries') || 0);",
                  "if (!ok && tries < 20) {",
                  "    pm.collectionVariables.set('tries', tries + 1);",
                  "    pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "    pm.collectionVariables.set('tries', 0);",
                  "    pm.test('Arrived through RabbitMQ', () => pm.expect(ok).to.be.true);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/parking-locations/{{locationId}}/spots"
          }
        },
        {
          "name": "Moving to the same spot is a conflict",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('Says why', () => pm.expect(pm.response.json().detail).to.eql('Your reservation is already for A3.'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/reservations/{{reservationId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"spotId\": \"{{spot3Id}}\"\n}"
            }
          }
        },
        {
          "name": "Move reservation back",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Holds A1 again', () => pm.expect(pm.response.json().spotCode).to.eql('A1'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/reservations/{{reservationId}}",
            "header": [
              {
